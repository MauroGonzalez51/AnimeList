{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "enables the default permissions",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "dialog:default",
        "fs:default",
        "fs:allow-exists",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file",
        {
            "identifier": "opener:allow-open-url",
            "allow": [{ "url": "https://www.google.com/*" }]
        }
    ]
}
