{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "AnimeList-Studio",
    "version": "0.1.0",
    "identifier": "com.maurogonzalez51.animelist-studio",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm generate",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "AnimeList Studio",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    },
    "plugins": {
        "cli": {
            "description": "AnimeList CLI & Studio Engine",
            "args": [
                {
                    "name": "store",
                    "short": "s",
                    "description": "Path to the YAML data store file",
                    "takesValue": true,
                    "multiple": false,
                    "global": true
                }
            ]
        }
    }
}
